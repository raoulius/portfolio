[Unit]
Description=Job Search (Streamlit)
After=network.target

[Service]
WorkingDirectory=/opt/jobs
EnvironmentFile=/opt/jobs/.env
ExecStart=/opt/jobs/.venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=always

[Install]
WantedBy=multi-user.target
